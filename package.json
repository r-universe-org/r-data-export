{
  "name": "@r-universe/r-data-export",
  "version": "0.1.0",
  "description": "Export datasets from R packages to csv, xlsx, json and more, using a pool of sandboxed webR processes",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "r-data-export": "bin/server.js"
  },
  "files": [
    "src/",
    "bin/"
  ],
  "scripts": {
    "start": "node bin/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "r-universe",
    "webr",
    "r",
    "datasets",
    "csv",
    "xlsx"
  ],
  "author": "Jeroen Ooms",
  "homepage": "https://github.com/r-universe-org/r-data-export",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r-universe-org/r-data-export.git"
  },
  "bugs": {
    "url": "https://github.com/r-universe-org/help/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@r-universe/webr": "^2026.4.14",
    "http-errors": "^2.0.1",
    "isbot": "^5.1.32",
    "tar-stream": "^3.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
